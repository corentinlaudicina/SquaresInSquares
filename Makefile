# Header dependencies are generated by the compiler (-MMD -MP) and pulled in at the bottom, so
# they can never go stale. They used to be listed by hand here, and moving a file into a
# subfolder silently broke the build.

CXX      := clang++
WARN     := -Wall -Wextra -Wpedantic
COMMON   := -std=c++20 $(WARN) -Isrc -MMD -MP
CXXFLAGS := $(COMMON) -O2 -pthread
DBGFLAGS := $(COMMON) -O0 -g -pthread -fsanitize=address,undefined

BUILD := build
OBJ   := $(BUILD)/obj
DOBJ  := $(BUILD)/dobj

GEOM := src/geometry/polygon.cpp
CORE := $(GEOM) src/geometry/cells.cpp src/system.cpp src/init.cpp src/moves/mc.cpp src/moves/regions.cpp src/moves/move_log.cpp src/io/io.cpp
RELAX := src/moves/relax.cpp
# The large-neighbourhood moves relax, so they sit outside CORE: test_io and test_system link
# CORE alone and have no business pulling L-BFGS in. See the layering note in lnm.hpp.
LNM := src/moves/lnm.cpp src/moves/symmetry.cpp
# merge/dissolve need no L-BFGS, same reason test_system links CORE alone: see the layering
# note above RELAX.
MERGE := src/merge/rectangle.cpp src/merge/merge.cpp

POLY_SRC := $(GEOM) tests/test_polygon.cpp
IO_SRC   := $(CORE) tests/test_io.cpp
SYS_SRC  := $(CORE) tests/test_system.cpp
RELAX_SRC := $(CORE) $(RELAX) tests/test_relax.cpp
LNM_SRC  := $(CORE) $(RELAX) $(LNM) tests/test_lnm.cpp
MERGE_SRC := $(CORE) $(MERGE) tests/test_merge.cpp
SYMMETRY_SRC := $(CORE) $(RELAX) $(LNM) tests/test_symmetry.cpp
MAIN_SRC := $(CORE) $(RELAX) $(LNM) src/main.cpp
SHRINK_SRC   := $(CORE) $(RELAX) $(LNM) src/main_shrink.cpp
COMPRESS_SRC := $(CORE) $(RELAX) $(LNM) src/main_compress.cpp

o  = $(1:%.cpp=$(OBJ)/%.o)
do = $(1:%.cpp=$(DOBJ)/%.o)

ALL_OBJ := $(call o,$(POLY_SRC) $(IO_SRC) $(SYS_SRC) $(RELAX_SRC) $(LNM_SRC) $(MERGE_SRC) $(SYMMETRY_SRC) $(MAIN_SRC) $(SHRINK_SRC) $(COMPRESS_SRC))
ALL_DOBJ := $(call do,$(POLY_SRC) $(IO_SRC) $(SYS_SRC) $(RELAX_SRC) $(LNM_SRC) $(MERGE_SRC) $(SYMMETRY_SRC))

all: test squares shrink compress

test:      $(BUILD)/test_polygon $(BUILD)/test_io $(BUILD)/test_system \
           $(BUILD)/test_relax $(BUILD)/test_lnm \
           $(BUILD)/test_merge $(BUILD)/test_symmetry
squares:   $(BUILD)/squares
shrink:    $(BUILD)/squares_shrink
compress:  $(BUILD)/squares_compress
debug:     $(BUILD)/test_polygon_debug $(BUILD)/test_io_debug \
           $(BUILD)/test_system_debug $(BUILD)/test_relax_debug \
           $(BUILD)/test_lnm_debug \
           $(BUILD)/test_merge_debug $(BUILD)/test_symmetry_debug

# Build and run every suite: the one target that proves the tests actually pass.
check: test
	./$(BUILD)/test_polygon
	./$(BUILD)/test_io
	./$(BUILD)/test_system
	./$(BUILD)/test_relax
	./$(BUILD)/test_lnm
	./$(BUILD)/test_merge
	./$(BUILD)/test_symmetry
	python3 -m unittest tools/test_validate.py

$(OBJ)/%.o: %.cpp
	@mkdir -p $(dir $@)
	$(CXX) $(CXXFLAGS) -c $< -o $@

$(DOBJ)/%.o: %.cpp
	@mkdir -p $(dir $@)
	$(CXX) $(DBGFLAGS) -c $< -o $@

$(BUILD)/test_polygon: $(call o,$(POLY_SRC))
	$(CXX) $(CXXFLAGS) $^ -o $@

$(BUILD)/test_io: $(call o,$(IO_SRC))
	$(CXX) $(CXXFLAGS) $^ -o $@

$(BUILD)/test_system: $(call o,$(SYS_SRC))
	$(CXX) $(CXXFLAGS) $^ -o $@

$(BUILD)/test_relax: $(call o,$(RELAX_SRC))
	$(CXX) $(CXXFLAGS) $^ -o $@

$(BUILD)/test_lnm: $(call o,$(LNM_SRC))
	$(CXX) $(CXXFLAGS) $^ -o $@

$(BUILD)/test_merge: $(call o,$(MERGE_SRC))
	$(CXX) $(CXXFLAGS) $^ -o $@

$(BUILD)/test_symmetry: $(call o,$(SYMMETRY_SRC))
	$(CXX) $(CXXFLAGS) $^ -o $@

$(BUILD)/squares: $(call o,$(MAIN_SRC))
	$(CXX) $(CXXFLAGS) $^ -o $@

$(BUILD)/squares_shrink: $(call o,$(SHRINK_SRC))
	$(CXX) $(CXXFLAGS) $^ -o $@

$(BUILD)/squares_compress: $(call o,$(COMPRESS_SRC))
	$(CXX) $(CXXFLAGS) $^ -o $@

$(BUILD)/test_polygon_debug: $(call do,$(POLY_SRC))
	$(CXX) $(DBGFLAGS) $^ -o $@

$(BUILD)/test_io_debug: $(call do,$(IO_SRC))
	$(CXX) $(DBGFLAGS) $^ -o $@

$(BUILD)/test_system_debug: $(call do,$(SYS_SRC))
	$(CXX) $(DBGFLAGS) $^ -o $@

$(BUILD)/test_relax_debug: $(call do,$(RELAX_SRC))
	$(CXX) $(DBGFLAGS) $^ -o $@

$(BUILD)/test_lnm_debug: $(call do,$(LNM_SRC))
	$(CXX) $(DBGFLAGS) $^ -o $@

$(BUILD)/test_merge_debug: $(call do,$(MERGE_SRC))
	$(CXX) $(DBGFLAGS) $^ -o $@

$(BUILD)/test_symmetry_debug: $(call do,$(SYMMETRY_SRC))
	$(CXX) $(DBGFLAGS) $^ -o $@

clean:
	rm -rf $(BUILD)

-include $(ALL_OBJ:.o=.d) $(ALL_DOBJ:.o=.d)

.PHONY: all test squares shrink compress debug check clean
